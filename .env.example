PORT=8080
HOST=0.0.0.0
# Directory for project files (pipelines, dashboard layouts).
# In Docker this is the ./pybi_data bind mount, so projects survive rebuilds.
DATA_DIR=/app/data

# Host port for the backend container (internal port stays 8000).
BACKEND_PORT=8001

# Leave empty for a process-local development key; set a random secret for production.
PYBI_JWT_SECRET=
PYBI_ENV=development

# Optional DuckDB resource limits.
# DUCKDB_THREADS=4
# DUCKDB_MAX_MEMORY=2GB

# Optional export output directory.
# EXPORTS_DIR=/app/data/exports

# Optional external service settings reserved for deployments that configure them.
# DATABASE_URL=
# REDIS_URL=
